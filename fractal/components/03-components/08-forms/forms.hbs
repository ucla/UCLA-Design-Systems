<h2>Default</h2>
<!-- Text Input Only -->
<div class="ucla-field">
  <label class="ucla-field__label" for="exampleTextField">Label</label>
  <div class="ucla-field__control">
    <input class="ucla-field__input" id="exampleTextField" type="text" placeholder="Text input">
  </div>
  <p class="ucla-field__help">Assistive text goes here</p>
</div>

<h2>Warning</h2>
<!-- Text Input Only -->
<div class="ucla-field ucla-is-warning">
  <label class="ucla-field__label" for="exampleTextFieldWarning">Label</label>
  <div class="ucla-field__control">
    <input class="ucla-field__input" id="exampleTextFieldWarning" type="text" value="Warning State" placeholder="Text input">
  </div>
  <p class="ucla-field__help">Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.</p>
</div>

<h2>Error</h2>
<!-- Text Input Only -->
<div class="ucla-field ucla-is-error">
  <label class="ucla-field__label" for="exampleTextFieldError">Label</label>
  <div class="ucla-field__control">
    <input class="ucla-field__input" id="exampleTextFieldError" type="text" value="Error State" placeholder="Text input">
  </div>
  <p class="ucla-field__help">Your username is invalid.</p>
</div>

<h2>Disabled</h2>
<!-- Text Input Only -->
<div class="ucla-field">
  <label class="ucla-field__label" for="exampleTextFieldDisabled">Label</label>
  <div class="ucla-field__control">
    <input class="ucla-field__input" id="exampleTextFieldDisabled" type="text" value="Disabled State" placeholder="Text input" disabled>
  </div>
</div>

<h2>Readonly</h2>
<!-- Text Input Only -->
<div class="ucla-field">
  <label class="ucla-field__label" for="exampleTextFieldReadonly">Label</label>
  <div class="ucla-field__control">
    <input class="ucla-field__input" id="exampleTextFieldReadonly" type="text" value="This text is readonly" readonly>
  </div>
  <p class="ucla-field__help">Assistive text goes here</p>
</div>

<h2>Icons</h2>
<!-- Text Input Only -->
<div class="ucla-field">
  <label class="ucla-field__label" for="exampleIconLeft">Label</label>
  <div class="ucla-field__control ucla-has-left-icon">
    <input class="ucla-field__input" id="exampleIconLeft" type="text" placeholder="Text input" />
    <span class="ucla-field__icon-left">
      <svg viewBox="0 0 20 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 16L0 0L20 0L20 16L0 16ZM10 9L18 4V2L10 7L2 2L2 4L10 9Z" fill="#333333"/>
      </svg>
    </span>
  </div>
</div>

<div class="ucla-field">
