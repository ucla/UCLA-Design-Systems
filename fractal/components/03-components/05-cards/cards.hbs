<article class="ucla-card">
  <img
    class="ucla-card__image"
    src="{{path '/theme-assets/img/examples/event-card-example-1.jpg'}}"
    alt="Two children on their phones under the blankets"
  />
  <div class="ucla-card__body">
    <h1 class="ucla-card__title"><span>{{title}}</span></h1>
    <p class="ucla-card__description">{{description}}</p>

    {{#each button}}
      <a href="#" class="ucla-card__link">
        {{cta-title}}
      </a>
    {{/each}}

  </div>
</article>

<figure class="ucla-img-ratio ucla-img-ratio-1x1">
  <iframe
    src="https://www.youtube.com/embed/eeFAXKYPkbw?si=inrgC02llVinyWHn"
    frameborder="0"
  ></iframe>
</figure>

<figure class="ucla-img-ratio ucla-img-ratio-16x9">
  <img
    src="{{path '/theme-assets/img/examples/event-card-example-1.jpg'}}"
    alt="Two children on their phones under the blankets"
  />
</figure>