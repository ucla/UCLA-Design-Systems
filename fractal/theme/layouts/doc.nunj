{% extends "layouts/pjax.nunj" if request.isPjax else 
    "layouts/frame.nunj" %}

{% block content %}

    <div class="Document">

        <div class="Document-header ucla-test">
            {% block docHeader %}
                <h1 class="headline-text__lg">{{ page.title }}</h1>
                {% if status %}{{ status }}
                {% endif %}
            {% endblock %}
        </div>

        <div class="Document-content ucla-content">

            {% block docContent %}{% endblock %}

        </div>

    </div>

{% endblock %}