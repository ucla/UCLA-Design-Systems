{
  "name": "ucla-design-systems",
  "description": "Official UCLA Design Systems",
  "homepage": "https://designsystem.brand.ucla.edu/",
  "version": "2.4.3",
  "author": "UCLA Strategic Communications",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/ucla/UCLA-Design-Systems"
  },
  "bugs": {
    "url": "https://github.com/ucla/UCLA-Design-Systems/issues",
    "email": "DesignSystem@stratcomm.ucla.edu"
  },
  "dependencies": {
    "@frctl/fractal": "^1.5.15",
    "@frctl/mandelbrot": "^1.10.3",
    "@material-symbols/svg-400": "^0.33.0",
    "fractal-status-helper": "^1.0.0",
    "swiper": "^11.2.4",
    "wicked-elements": "^3.1.2"
  },
  "browserslist": [
    "> 1%",
    "last 1 Android versions",
    "last 1 ChromeAndroid versions",
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 Edge versions",
    "last 2 Opera versions"
  ],
  "scripts": {
    "start": "fractal start --sync --watch",
    "build": "npm-run-all css js svg docs-build",
    "docs-build": "fractal build",
    "css": "npm-run-all css-compile css-compile-docs css-autoprefix css-minify-*",
    "start-with-lint": "npm-run-all css-lint start",
    "css-compile": "sass --style expanded --source-map --embed-sources --no-error-css scss/:public/css/",
    "css-compile-docs": "sass --style expanded --source-map --no-error-css theme/assets/scss/:theme/assets/css/",
    "css-autoprefix": "postcss --use autoprefixer --map false --output public/css/ucla-lib.css public/css/ucla-lib.css",
    "css-minify-main": "cleancss -O1 --format breakWith=lf --with-rebase --source-map --source-map-inline-sources --output public/css/ --batch --batch-suffix \".min\" \"public/css/*.css\" \"!public/css/*.min.css\" \"!public/css/*rtl*.css\"",
    "css-lint": "npm-run-all --aggregate-output --continue-on-error --parallel css-lint-*",
    "css-lint-stylelint": "stylelint \"scss/**/*.scss\" --cache --cache-location .cache/.stylelintcache",
    "css-lint-vars": "fusv scss/**/",
    "js": "npm-run-all js-lint js-compile js-minify",
    "js-compile": "node ./tasks/compile-js.js",
    "js-minify": "terser public/js/ucla-lib-scripts.js -o public/js/ucla-lib-scripts.min.js -c --source-map \"root='js'\"",
    "js-lint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives --ext js/*.js",
    "svg": "npm-run-all svg-compile-*",
    "svg-compile-navigation": "svgo -f ./icons/navigation/ -o ./public/icons/navigation/",
    "svg-compile-communication": "svgo -f ./icons/communication/ -o ./public/icons/communication/",
    "svg-compile-content": "svgo -f ./icons/content/ -o ./public/icons/content/",
    "svg-compile-date-time": "svgo -f ./icons/date-time/ -o ./public/icons/date-time/",
    "svg-compile-social": "svgo -f ./icons/social/ -o ./public/icons/social/",
    "svg-compile-weather": "svgo -f ./icons/weather/ -o ./public/icons/weather/",
    "svg-compile-alert": "svgo -f ./icons/alert/ -o ./public/icons/alert/",
    "svg-compile-material": "svgo --config ./tasks/compile-material-symbols.mjs -f ./node_modules/@material-symbols/svg-400/outlined/ --exclude '-fill.' -o ./public/icons/material/",
    "token-build": "node ./tasks/compile-tokens.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "clean-css-cli": "^5.6.2",
    "del": "^6.1.1",
    "esbuild": "^0.17.12",
    "eslint": "^8.57.0",
    "find-unused-sass-variables": "^4.0.6",
    "fs-extra": "^11.3.0",
    "handlebars": "^4.7.8",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.21",
    "postcss-cli": "^10.1.0",
    "sass": "^1.59.3",
    "sass-true": "^7.0.0",
    "style-dictionary": "^3.9.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^31.0.0",
    "stylelint-config-standard-scss": "^7.0.1",
    "stylelint-order": "^6.0.4",
    "svgo": "^3.0.2",
    "terser": "^5.16.6"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=18.20.8"
  },
  "sass": "scss/ucla-lib.scss",
  "style": "public/css/ucla-lib.css",
  "files": [
    "build/css/**/*.{css,map}",
    "build/js/**/*.{js,map}",
    "build/icons/**/*.svg",
    "js/**/*.js",
    "icons/**/*.svg",
    "scss/**/*.scss",
    "build/tokens/**/*",
    "README.md"
  ]
}
